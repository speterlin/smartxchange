function setTimeZoneOffset() {
    var current_time = new Date();
    // gets timezone offset in minutes, offset off of GMT
    document.cookie = 'time_zone='+current_time.getTimezoneOffset();
}
setTimeZoneOffset()

function translateText(response) {
  if (response.error) {
    document.getElementById("translation").innerHTML += "<br>"+response.error.errors[0].message;
  } else {
    document.getElementById("translation").innerHTML += "<br>" + response.data.translations[0].translatedText;
  }
}
function getTranslation() {
  var newScript = document.createElement('script');
  newScript.type = 'text/javascript';
  var sourceText = escape($('#message-body').val());
  var fromLang = $("select#from-language option:selected").val()
  var toLang = $("select#to-language option:selected").val()
  // To prevent misuse, restrict your key to designated domains or use a
  // proxy to hide your key.
  var source = "https://www.googleapis.com/language/translate/v2?key=<%= ENV['GOOGLE_API_KEY'] %>&source="+fromLang+"&target="+toLang+"&callback=translateText&q=" + sourceText;
  newScript.src = source;
  $('#translation').empty()
  document.getElementById('translation-section').appendChild(newScript);
}

function addEventEditPost (edit_post) {
  $(edit_post).on('click', function(event) {
    var board_id = $('#board-description').data('board-id');
    var post_id = $(this).data('post-id');
    if (!$(this).data('clicked')) {
      var post_content = $('#post-'+post_id+' .post-text').text();
      var post_category = $('#post-'+post_id+' .post-category').data('category');
      // so that post_location is not listed as undefined below
      var post_location = $('#post-'+post_id+' .post-location').data('location') ? $('#post-'+post_id+' .post-location').data('location') : "";
      $('#post-'+post_id+' .post-text').remove();
      // hack job until I find a better solution, can't render js variable in rendered ruby code, server side vs. client side
      var form = "<div class='post-form edit'><form action='/posts/"+post_id+"' method='post' data-remote='true'>";
      form += "<input type='hidden' name='_method' value='patch'>";
      form += "<input type='hidden' name='authenticity_token' value='"+$('meta[name="csrf-token"]')[0].content+"'>";
      form += "<textarea class='textcomplete' name='post[content]'>"+post_content+"</textarea>";
      form += "<input type='hidden' name='post[board_id]' value='"+board_id+"'>";
      form += "<input type='submit' class='btn btn-primary send-post'  value='Edit'>";
      form += "<div id='post-category'> Category: <select name='post[category]'>";
      if (board_id == 2) {
        form+= "<option value='Jobs-Offered' "+(post_category == 'Jobs-Offered' ? 'selected' : '') +" >Jobs Offered</option><option value='Jobs-Wanted' "+(post_category == 'Jobs-Wanted' ? 'selected' : '') +" >Jobs Wanted</option>";
      } else {
        form += "<option value='Interest' "+(post_category == 'Interest' ? 'selected' : '')+" >Interest</option><option value='Educational' "+(post_category == 'Educational' ? 'selected' : '')+" >Educational</option><option value='Tutoring' "+(post_category == 'Tutoring' ? 'selected' : '')+" >Tutoring</option><option value='Meetup' "+(post_category == 'Meetup' ? 'selected' : '')+" >Meetup</option><option value='Professional' "+(post_category == 'Professional' ? 'selected' : '')+" >Professional</option><option value='Other' "+(post_category == 'Other' ? 'selected' : '')+" >Other</option>";
      }
      form += "</select><br>";
      form += "<div class='post-location edit' data-location='"+post_location+"' >";
      if (post_category == 'Meetup') {
        form += "<label>Location (City, Country / Landmark) <input type='text' name='post[location]' value='"+post_location+"'></label>";
      }
      form += "</div>";
      form += "</form></div>";
      $('#post-'+post_id+' .post-votes').after(form);
      addTextCompleteForHashtagsAndUsertags($('#post-' + post_id + ' .textcomplete'));
      $(this).data('clicked', true);
      // needs refactoring
      $('#post-'+post_id+' #post-category select').on('change', function() {
        if ($(this).find(":selected").val() == "Meetup") {
          var post_location = $('#post-'+post_id+' .post-location').data('location');
          if (post_location) {
            $('#post-'+post_id+' .post-location.edit').html("<label>Location (City, Country / Landmark) <input type='text' name='post[location]' value='"+post_location+"'></label>");
          } else {
            $('#post-'+post_id+' .post-location.edit').html("<label>Location (City, Country / Landmark) <input type='text' name='post[location]' value=''></label>");
          }
        } else {
          // maybe refactor this, not clearing out entire div, just emptying it
          $('#post-'+post_id+' .post-location.edit').html("");
          $('#post-'+post_id+' .post-location.edit').append("<input type='hidden' name='post[location]' value=''>");
        }
      })
    } else {
      var post_content = $('.post-form.edit textarea').val();
      $('#post-'+post_id+' .post-form.edit').remove();
      $('#post-'+post_id+' .post-votes').after("<div class='post-text'>"+renderPostOrCommentWithHashtagsAndUsertags(post_content)+"</div>");
      $(this).data('clicked', false);
    }
    event.preventDefault();
  })
}
function addEventEditComment (edit_comment, post_id) {
  $(edit_comment).on('click', function(event) {
    var comment_id = $(this).data('comment-id');
    if (!$(this).data('clicked')) {
      var comment_content = $('#comment-'+comment_id+' .comment-text').text();
      $('#comment-'+comment_id+' .comment-text').remove();
      // hack job until I find a better solution, can't render js variable in rendered ruby code, server side vs. client side
      var form = "<div class='comment-form edit'><form action='/comments/"+comment_id+"' method='post' data-remote='true'>";
      form += "<input type='hidden' name='_method' value='patch'>";
      form += "<input type='hidden' name='authenticity_token' value='"+$('meta[name="csrf-token"]')[0].content+"'>";
      form += "<textarea class='textcomplete' name='comment[content]'>"+comment_content+"</textarea>";
      form += "<input type='hidden' name='comment[commentable_type]' value='Post'>";
      form += "<input type='hidden' name='comment[commentable_id]' value='"+post_id+"'>";
      form += "<input type='submit' class='btn btn-primary send-comment' value='Edit'>";
      form += "</form></div>";
      $('#comment-'+comment_id+' time').before(form);
      addTextCompleteForHashtagsAndUsertags($('#post-' + post_id + ' .textcomplete'));
      $(this).data('clicked', true);
    } else {
      var comment_content = $('.comment-form.edit textarea').val();
      $('#comment-'+comment_id+' .comment-form.edit').remove();
      $('#comment-'+comment_id+' time').before("<div class='comment-text'>"+renderPostOrCommentWithHashtagsAndUsertags(comment_content)+"</div>");
      $(this).data('clicked', false);
    }
    event.preventDefault();
  })
}

// maybe refactor, important to note difference in regex between here and in other places where we match usertags (taggable.rb, application.js.erb, boards_helper.rb) in that here we are using () to match group where we would otherwise use [] to match single characters
function addTextCompleteForHashtagsAndUsertags($textarea) {
  $textarea.textcomplete([
    {
      // Usertag strategy
      match: /(\s|^)@([^\s]+)$/,
      search: function (term, callback) {
        $.getJSON('/users/autocomplete_usertag', { query: term })
          .done(function (resp) { callback(resp); })
          .fail(function ()     { callback([]);   });
      },
      replace: function (value) {
        return '$1' + value + ' ';
      }
    },
    {
      // Hashtag strategy
      match: /(\s|^)#(\w+)$/,
      search: function (term, callback) {
        $.getJSON('/posts/autocomplete_hashtag', { query: term })
          .done(function (resp) { callback(resp); })
          .fail(function ()     { callback([]);   });
      },
      replace: function (value) {
        return '$1' + value + ' ';
      }
    }
  ]);
}

function hashtagReplacer(match) {
  match = match.trim();
  var word = match.replace('#','');
  return "<a href='/boards/hashtag?tag=" + word + "'>" + match + "</a>";
}

function usertagReplacer(match) {
  match = match.trim();
  var name = match.replace('@','');
  return "<a href='/users/" + name.split('.').join('%20').toLowerCase() + "'>" + match + "</a>";
}

// maybe refactor, name could be renderPostOrCommentWithTags, not html safe at the moment - may add later, javascript doesn't support look-behind (like used in taggable.rb and boards_helper.rb) and therefore scanning for whitespace before tag
function renderPostOrCommentWithHashtagsAndUsertags(content) {
  return content.replace(/(\s|^)#\w+/g, hashtagReplacer)
  .replace(/(\s|^)@[^\s]+/g, usertagReplacer);
}
