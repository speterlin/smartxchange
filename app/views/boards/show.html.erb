<h1><%= @board.title %></h1>
<div id="board-description" data-board-id="<%= @board.id %>">
  <%= @board.description %>
</div>
<br>

<ul id="posts">
  <% if @board.id == 2 %>
    <ul id="jobs-offered">
      <h3>Jobs Offered</h3>
      <%= render @jobs_offered_posts if @jobs_offered_posts.any? %>
    </ul>
    <ul id="jobs-wanted">
      <h3>Jobs Wanted</h3>
      <%= render @jobs_wanted_posts if @jobs_wanted_posts.any? %>
    </ul>
  <% else %>
    <ul id="interest">
      <h3>Interest</h3>
      <%= render @interest_posts if @interest_posts.any? %>
    </ul>
    <ul id="educational">
      <h3>Educational</h3>
      <%= render @educational_posts if @educational_posts.any? %>
    </ul>
    <ul id="tutoring">
      <h3>Tutoring</h3>
      <%= render @tutoring_posts if @tutoring_posts.any? %>
    </ul>
    <ul id="meetup">
      <h3>Meetups</h3>
      <%= render @meetup_posts if @meetup_posts.any? %>
    </ul>
    <ul id="professional">
      <h3>Professional</h3>
      <%= render @professional_posts if @professional_posts.any? %>
    </ul>
    <ul id="other">
      <h3>Other</h3>
      <%= render @other_posts if @other_posts.any? %>
    </ul>
  <% end %>
</ul>
<br>

<div class="post-form new">
  <form action="<%= posts_path %>" method="post" data-remote="true">
    <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
    <textarea id="message-body" name="post[content]"></textarea>
    <input type="hidden" name="post[board_id]" value="<%= @board.id %>">
    <input type="submit" class="btn btn-primary send-post"  value="Post">
    <div id="post-category">
      Category: <select name="post[category]">
        <% if @board.id == 2 %>
          <option value="Jobs-Offered">Jobs Offered</option>
          <option value="Jobs-Wanted">Jobs Wanted</option>
        <% else %>
          <option value="Interest">Interest</option>
          <option value="Educational">Educational</option>
          <option value="Tutoring">Tutoring</option>
          <option value="Meetup">Meetup</option>
          <option value="Professional">Professional</option>
          <option value="Other">Other</option>
        <% end %>
      </select>
    </div>
    <div id="post-location">
    </div>
  </form>
</div>
<br>
<%= render 'layouts/translate' %>

<script type="text/javascript">
  $('.edit-post').each(function(index, value) {
    addEventEditPost(value);
  })
  $('.edit-comment').each(function(index, value) {
    // regex and parents() hack to get post parent may need to change later
    var post_id = $(value).parents().eq(4)[0].id.match(/[0-9]+/i)[0];
    addEventEditComment(value, post_id);
  })
  // probably need to refactor, location.reload(true) clears cache, currently every time page is loaded cached items are loaded and new, essentially script tag is being called twice
  <% if @notification %>
    <% if @notification.sourceable_type == "Comment" %>
      $('#comment-<%= @notification.sourceable_id %>').css("background-color", "yellow");
    <% elsif @notification.sourceable_type == "Vote" %>
      $('#post-<%= @notification.notifiable_id %> .vote-numbers').css("background-color", "yellow");
    <% elsif @notification.sourceable_type == "Follow" %>
      $('#post-<%= @notification.notifiable_id %> .post-followers').css("background-color", "yellow")
    <% elsif @notification.sourceable_type == "Post" %>
      //these are the two elements that can change if a post is updated
      $('#post-<%= @notification.notifiable_id %> .post-text').css("background-color", "yellow");
      $('#post-<%= @notification.notifiable_id %> .post-category').css("background-color", "yellow");
    <% end %>
    // only way to make it work is with setTimeout, prefer scrollIntoView over window.location.href
    setTimeout(function(){document.getElementById('post-<%= @notification.notifiable_id %>').scrollIntoView()},0);
  <% end %>
  // probably need to refactor this and application.js.erb, same code 
  $('.post-form.new #post-category').on('change', function() {
    if ($(this).find(":selected").val() == "Meetup") {
      $('#post-location').html("<label>Location (City, Country / Landmark) <input type='text' name='post[location]'></label>")
    } else {
      $('#post-location').text("");
    }
  })
</script>
