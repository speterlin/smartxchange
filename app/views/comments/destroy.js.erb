//maybe refactor, same code as posts/update.js.erb and comments/create.js.erb
$('#post-<%= @post.id %>').remove();
$('#posts ul#<%= @post.category.downcase %>').append("<%= j(render(:partial => 'posts/post', :locals => {post: @post})) %>")
addEventEditPost($('#post-<%= @post.id %> .edit-post'));
$('#post-<%= @post.id %> .edit-comment').each(function(index, value) {
  addEventEditComment(value, <%= @post.id %>);
})

<%= render partial: 'layouts/move_post_up', locals: { up_votes: @post.votes.sum(:value), post: @post, moved: false }  %>
