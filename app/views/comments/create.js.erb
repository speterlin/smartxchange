//maybe refactor, same code as posts/update.js.erb but moved is passed in as false instead of true
$('#post-<%= @post.id %>').remove();
$('#posts ul#<%= @post.category.downcase %>').append("<%= j(render(:partial => 'posts/post', :locals => {post: @post, board: @post.board})) %>")
addEventEditPost($('#post-<%= @post.id %> .edit-post'));
$('#post-<%= @post.id %> .edit-comment').each(function(index, value) {
  addEventEditComment(value, <%= @post.id %>);
})
addTextcompleteForHashtagsAndUsertags($('#post-<%= @post.id %> .textcomplete'))

<%= render partial: 'layouts/move_post_up', locals: { up_votes: @post.votes.sum(:value), post: @post, moved: false }  %>
