<div class="row">

    <div id="profile-left">
      <div id="user-image">
        <p>
          <%= image_tag(@user.image.thumb.url, alt: @user.name) %><br>
        </p>
      </div>
      <br>
      <%= link_to "Remove Image", remove_image_user_path(@user), data: {confirm: "Are you sure you wish to delete your profile image? Your image will be replaced with the default avatar image"} if @user == current_user && @user.image? %>
      <%= image_tag "http://maps.googleapis.com/maps/api/staticmap?center=#{@user.latitude},#{@user.longitude}&markers=#{@user.latitude},#{@user.longitude}&zoom=12&size=250x250&key=#{ENV['GOOGLE_API_KEY']}", alt: "#{@user.name} on the map" if current_user == @user %>
    </div>

    <div id="profile-center">
      <!-- maybe move this later -->
      <% if @user.active  %>
        <%= image_tag('green-dot.png', alt: 'Active') %> <br>
      <% end  %>
      <% if current_user == @user %>
          <form action="<%= user_path(@user) %>" method="post" enctype="multipart/form-data">
            <input type="hidden" name="_method" value="patch">
            <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
            <label for="user-name">Name / Nickname</label><br>
            <input id="user-name" name="user[name]" type="text" value="<%= @user.name %>"><br>
            <label for="user-birthdate">Birthdate</label><br>
            <input id="user-birthdate" name="user[birthdate]" type="date" value="<%= @user.birthdate %>"><br>
            <label for="user-title">Profession / Title</label><br>
            <textarea id="user-title" name="user[title]" rows="3"><%= @user.title %></textarea><br>
            <label for="user-language">Language (to practice)</label><br>
              <select id="user-language" name="user[language]">
                <% User::LANGUAGES.each do |language| %>
                  <option value="<%= language %>" <%= 'selected' if @user.language==language %> ><%= language %></option>
                <% end %>
             </select><br>
            <label for="user-language-level">Language level</label><br>
              <select id="user-language-level" name="user[language_level]">
                <% User::LANGUAGE_LEVELS.each do |language_level| %>
                  <option value="<%= language_level %>" <%= 'selected' if @user.language_level==language_level %> ><%= user_convert_to_presented_language_level(language_level) %></option>
                <% end %>
               </select><br>
            <label for="user-nationality">Native country</label><br>
              <select id="user-nationality" name="user[nationality]">
                <% User::NATIONALITIES.each do |country, nationality| %>
                  <option value="<%= nationality %>" <%= "selected" if @user.nationality == nationality %> ><%= country %></option>
                <% end %>
              </select><br>
            <label for="user-location">Location (City, Country / Landmark)</label><br>
            <input id="user-location" type="text" name="user[location]" value="<%= @user.location %>"><br>
            <label for="user-image">Picture</label><br>
            <input id="user-image" type="file" name="user[image]" value="<%= @user.image.small_thumb %>"><br>

            <input class="btn btn-primary" type="submit" value="Update">
          </form>

      <% else %>
        <!-- need to refactor this, span part -->
        <h1><%= @user.name %></h1>
        <h4><span><%= @user.age %></span></h4>
        <h4><i><%= auto_link(@user.title, html: { target: '_blank' }) %></i></h4>
        <h4><b><%= "#{@user.language}, "%></b><span><%= user_convert_to_presented_language_level(@user.language_level) %></span></h4>
        <h4><%= @user.nationality %> <span>National</span></h4>
        <% if @user.person_of_interest? %> <h4>Person of Interest</h4> <% end %>
        <% if @user.tutor?  %> <h4>Tutor</h4> <% end %>
        <h4><span><i><%= @user.location %></i></span></h4><br>
        <!-- may change class to start-chat but have to make sure it doesn't conflict with js code -->
        <br>

        <form action="<%= conversations_path %>" method="post">
          <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
          <input type="hidden" name="chat_room[recipient_id]" value="<%= @user.id%>">
          <input type="submit" class="btn btn-primary" value="Enter Conversation" >
        </form>
      <% end %>
    </div>

    <!-- Display linkedin information -->
    <div id="profile-right">
      <% if @user.linkedin %>
        <br> <!-- maybe refactor later break is just for appearances now -->
        <a href="<%= @user.linkedin.public_url %>" target="_blank"><%= image_tag('linkedin-icon.png', alt: 'Linkedin') %></a>
        <h4><%= @user.linkedin.industry %></h4>
        <p><span><%= @user.linkedin.summary %></span></p>
        <% if @user == current_user  %>
          <%= button_to "Update Linkedin", add_or_update_omniauth_path, method: :get, class: "btn btn-primary linkedin" %><br>
          <%= button_to "Delete Linkedin", omniauth_path, method: :delete, data: {confirm: "Are you sure you want to delete the Linkedin information associated with your account? Warning: If you registered with Linkedin you will not be able to sign back in to this account."}, class: "btn btn-primary delete" %>
        <% end  %>
      <% elsif @user == current_user %>
        <%= button_to "Add Linkedin", add_or_update_omniauth_path, method: :get, data: {confirm: "smartXchange will have access to your basic Linkedin profile and Linkedin email, are you sure?"}, class: "btn btn-primary linkedin" %>
      <% end %>
    </div>
</div>

<div class="row">

  <div id="tutor-materials">
    <% if @user.tutor? %>
      <br><h4>Tutor materials</h4>
      <ul id="materials">
        <% if @materials.any? %>
            <%= render @materials %>
        <% elsif @user != current_user && current_user.premium_or_admin? %>
          <h5>Tutoring materials are on their way...</h5>
        <% elsif @user != current_user && !current_user.premium_or_admin?  %>
          <%= link_to "Upgrade to Premium", "/about#premium", class: 'btn btn-primary premium' %>
        <% end %>
      </ul>
      <!-- upload form -->
      <% if @user == current_user %>
        <form action="<%= user_materials_path(@user) %>" method="post" data-remote="true" enctype="multipart/form-data">
          <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
          <input type="hidden" name="material[owner_id]" value="<%= @user.id %>">
          <label for="material-name"></label>
          <input id="material-name" type="text" name="material[name]" >
          <label for="material-attachment"></label>
          <input id="material-attachment" type="file" name="material[attachment]">
          <select id="material-language" name="material[language]">
            <% User::LANGUAGES.each do |language| %>
              <option value="<%= language %>" <%= 'selected' if user_convert_to_language(@user.nationality) == language %> ><%= language %></option>
            <% end %>
          </select>
          <select id="material-language-level" name="material[language_level]">
            <% User::LANGUAGE_LEVELS.each do |language_level| %>
              <option value="<%= language_level %>" ><%= user_convert_to_presented_language_level(language_level) %></option>
            <% end %>
          </select>
          <input class="btn btn-primary" type="submit" value="Upload">
          <span>(Max file size: 5mb)</span>
        </form>
      <% end %>
    <% end %>
  </div>

  <div id="user-interests">
    <br><h4>Interests <%= "(Choose 10)" if @user == current_user %></h4>
    <% if @user == current_user %>
      <form action="<%= update_interests_user_path(@user) %>" method="post">
        <input type="hidden" name="_method" value="patch">
        <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
        <% 3.times do |num| %>
          <!-- + 1 to be consistent with checkbox indexing -->
          <div class="column <%= num + 1 %>">
            <% 10.times do |sub_num| %>
              <% sub_num = 10 * num + sub_num + 1 %>
              <!-- interest-checkbox so there is no conflict with .checkbox styling -->
              <div class="interest-checkbox <%= sub_num %>">
                <!-- maybe refactor to_s and to_i below with inserting interests into user interest array, have to deal with existing user values -->
                <input type="checkbox" id="checkbox <%= sub_num %>" name="user[interests][]" value=<%= sub_num %> <%= 'checked' if @user.interests.include?(sub_num) %> >
                <label for="checkbox <%= sub_num %>"><%= user_convert_to_interest(sub_num) %></label><br>
              </div>
            <% end %>
          </div>
        <% end %>
        <input class="btn btn-primary" type="submit" value="Update Interests">
      </form>
    <% elsif @user.interests.any? %>
      <ul>
        <% @user.interests.each do |interest_num| %>
          <li><%= user_convert_to_interest(interest_num) %></li>
        <% end %>
      </ul>
    <% else %>
      <h5>No Interests to display</h5>
    <% end %>
  </div>

  <div id="user-reviews">
    <br><h4>Reviews</h4>
    <% if @user.reviews.any? %>
      <ul>
        <% @user.reviews.each do |review| %>
          <li id="review-<%= review.id %>"><span style="font-weight:700;"><%= review.language %></span>, rated  <i><span><%= user_convert_to_presented_language_level(review.language_level) %></span></i> by <%= link_to review.reviewer.name, user_path(review.reviewer) %></li>
        <% end %>
      </ul>
    <% else %>
        <h5>No Reviews to display<%= ", exchange over 100 messages with another user to get reviews" if @user == current_user %></h5>
    <% end %>
  </div>

  <div id="user-chatbots">
    <!-- refactor for when there are chatbots -->
    <% if @user.id == 1 %>
      <br><h4>Contributed Chatbots</h4>
      <ul><li><%= link_to "#{User.find(6).name}, ", user_path(User.find(6)) %><i><span><%= User.find(6).language %> <%= user_convert_to_presented_language_level(User.find(6).language_level) %></span></i> Chatbot</li></ul>
    <% end %>
  </div>

</div>


<script type="text/javascript">
  if (window.location.href.indexOf("#review-") != -1) {
    var review = window.location.href.split('#')[1]
    $('#'+review).css("background-color", "yellow");
  }
</script>
