<div class="col-md-4 portfolio-item" style="<%= user.person_of_interest? ? 'border:1px solid #fed136;border-radius:5px;' : user.chat_bot? ? 'border:1px solid #1919ff;border-radius:5px;' : user.tutor? ? 'border:1px solid #8fb8e2;border-radius:5px;' : '' %>">
    <a href="<%= user_path(user) %>">
        <div class="user-image">
          <!-- kind of hack with paragraph to align image may need to refactor -->
          <p><%= image_tag(user.image.small_thumb.url, alt: user.name) %></p>
        </div>
        <% if user.linkedin %>
          <%=  image_tag('linkedin-button-small.png', class: 'linkedin-button')  %>
        <% end %>
        <div class="user-content">
          <div class="name">
            <h3><%= user.name %> <%= image_tag('green-dot.png', alt: 'Active') if user.active %></h3>
          </div>
          <div class="age">
            <i><%= user.age %></i>
          </div>
          <div class="language">
            <h4><%= user.language %>, <span style="font-weight:normal"><%= user_convert_to_presented_language_level(user.language_level) %></span></h4>
          </div>
          <div class="title">
            <%= truncate(user.title, :length => 65) %>
          </div>
        </div>
    </a>
</div>
