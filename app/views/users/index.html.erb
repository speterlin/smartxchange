<!-- Header Row -->
<!-- maybe refactor this a little -->
  <div class="row">
    <h4>
      <a href="<%= users_path(scope: 'tutors') %>">Tutors: <span style="font-weight: 300;"><%= User.where(tutor: true).count %></span></a>,
      <% if current_user.admin? %>
        <a href="<%= users_path(scope: 'active') %>">Active: <span style="font-weight: 300;"><%= User.where(active: true).count %></span></a>,
        <a href="<%= users_path(scope: 'map') %>">Map: <span style="font-weight: 300;"><%= User.where.not(latitude: nil).count %></span></a>,
      <% end %>
      <a href="<%= users_path(scope: 'exchange') %>">Xchange: <span style="font-weight: 300;"><%= current_user.sort_exchange.count %></span></a>,
      <a href="<%= users_path(scope: 'all') %>">All: <span style="font-weight: 300;"><%= User.all.count %></span></a>,
      <a href="<%= users_path(language: 'Spanish') %>"><%= user_convert_language_or_nationality_to_img('Spanish') %> : <span style="font-weight: 300;"> <%= User.where(language: 'Spanish').count %> </span></a>,
      <a href="<%= users_path(language: 'Italian') %>"><%= user_convert_language_or_nationality_to_img('Italian') %> : <span style="font-weight: 300;"> <%= User.where(language: 'Italian').count %> </span></a>,
      <a href="<%= users_path(language: 'German') %>"><%= user_convert_language_or_nationality_to_img('German') %> : <span style="font-weight: 300;"> <%= User.where(language: 'German').count %> </span></a>,
      <a href="<%= users_path(language: 'French') %>"><%= user_convert_language_or_nationality_to_img('French') %> : <span style="font-weight: 300;"> <%= User.where(language: 'French').count %> </span></a>,
      <a href="<%= users_path(language: 'English') %>"><%= user_convert_language_or_nationality_to_img('British') %> : <span style="font-weight: 300;"> <%= User.where(language: 'English').count %> </span></a>
      <a href="<%= users_path(language: 'Mandarin Chinese') %>"><%= user_convert_language_or_nationality_to_img('Chinese') %> : <span style="font-weight: 300;"> <%= User.where(language: 'Mandarin Chinese').count %> </span></a>
      <a href="<%= users_path(language: 'Danish') %>"><%= user_convert_language_or_nationality_to_img('Danish') %> : <span style="font-weight: 300;"> <%= User.where(language: 'Danish').count %> </span></a>
    </h4>
  </div>

<!-- Users Row -->
<div id="users">
  <% unless @users.empty? %>
      <!-- rows of users -->
      <% columns = 3  %>
      <% rows = 4 %>
      <% i = 0  %>
      <% while i < rows %>
        <% current_slice = i * columns  %>
        <% if @users.length > current_slice %>
          <!-- /.row -->
          <div class="row">
            <% @users.to_a.slice(current_slice, columns).each do |user| %>
              <%=  render 'users/user', user: user %>
            <% end  %>
          </div>
        <% end %>
        <% i += 1   %>
      <% end %>

    <%= will_paginate @users%>
  <% end %>
</div>
