<!-- may need to refactor this (body) -->
<body class="new">

<div class="col-lg-12 text-center">

  <h2 class="new section-heading">Welcome To Our Platform</h2>
  <h3 class="new section-subheading">Helping the world communicate better</h3>
  <h4 class="new subheading">Join our language learning community with over <%= pluralize(@user_count, 'user') %> and <%= pluralize(@jobs_offered_count, 'job') %> offered!</h4>
  <br>
  <a href="/about" class="page-scroll btn btn-xl">Tell Me More</a>

  <br>
  <br>
  <!-- Register with Linkedin -->
  <%= button_to "Register with Linkedin", new_linkedin_session_path, method: 'get', data: {confirm: "smartXchange will have access to your basic Linkedin profile and Linkedin email, are you sure?"}, class: 'btn btn-primary linkedin' %>

  <h4 class="new subheading">OR</h4>

  <!-- Sign up form -->
  <form action="/users" method="post" class="new">
    <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
    <label>Email<br>
      <input id="user-email" name="user[email]" type="text" value="<%= @user.email if @user %>"><br>
    </label><br>
    <label>Password<br>
      <input id="user-password" name="user[password]" type="password" autocomplete="off"><br>
    </label><br>
    <label>Name / Nickname<br>
      <input id="user-name" name="user[name]" type="text" value="<%= @user.name if @user %>"><br>
    </label><br>
    <label>Age<br>
      <input id="user-age" name="user[age]" type="text" value="<%= @user.age if @user %>"><br>
    </label><br>
    <label>Profession / Title<br>
      <textarea id="user-title" name="user[title]" rows="3" cols="25"><%= @user.title if @user %></textarea><br>
    </label><br>
    <label>Language (to practice)<br>
      <select name="user[language]">
        <% User::LANGUAGES.each do |language| %>
          <option value="<%= language %>" <%= 'selected' if @user && @user.language==language %> ><%= language %></option>
        <% end %>
     </select>
    </label>
    <label>Language level <br>
      <select name="user[language_level]">
        <% User::LANGUAGE_LEVELS.each do |language_level| %>
          <option value="<%= language_level %>" <%= 'selected' if @user && @user.language_level==language_level %> ><%= user_convert_language_level(language_level) %></option>
        <% end %>
     </select>
    </label><br>
    <label>Native country<br>
      <select name="user[nationality]">
        <% user_nationalities.each do |nationality| %>
          <!-- default to Spanish if not selected -->
          <option value="<%= nationality[0] %>" <%= @user ?  @user.nationality == nationality[0] ? "selected" : "" : nationality[0] == "Spanish" ? "selected" : "" %> ><%= nationality[1] %></option>
        <% end %>
     </select>
   </label><br><br>
   <%= recaptcha_tags %><br>
   <input type="hidden" name="user[terms]" value=0>
   <input type="checkbox" id="user-terms" name="user[terms]" value=1>
   <label for="user-terms"><%= link_to "Terms of Service, Privacy, and Cookie Policy", "ToS, Privacy, Cookie Policy.pdf", style: "color: white;" %></label></br></br>

   <input type="submit" value="Register" class="btn btn-primary"><br>

  </form>
  <!-- hack job need to refactor with padding or margin -->

  <br>
  <br>
  <br>

</div>

</body>
