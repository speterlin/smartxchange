<!-- this class has no styling at the moment may want to maybe refactor later -->
<h2>
  <a class="chat-room-show" href="<%=user_path(@receiver)%>">
    <div class="user-image">
      <p><%= image_tag(@receiver.image.small_thumb.url, alt: @receiver.name) %></p>
    </div>
    <div class="chat-room-show-content">
      <p>
        <%= " #{@receiver.name} " %>
        <%= image_tag('green-dot.png', alt: 'Active') if @receiver.active %>
        <%= " - #{@chat_room.title} Conversation"%>
      </p>
    </div>
  </a>
</h2>

<div id="messages" data-chat-room-id="<%= @chat_room.id %>">
  <%= render @messages %>
</div>

<br/><br/>
<!-- class and id are new_message -->
<div id="message-form">
  <%= form_for @message, url: '#' do |f| %>
  <%= f.text_area :body, id: 'message-body' %>
  <%= f.submit 'Send', class: 'btn btn-primary send-message' %>
  <% end %>
</div>
<br>
<%= render 'layouts/translate' %>
