var prev_post = $('#post-<%= @post.id %>').prev();
$('#post-<%= @post.id %>').remove();
if (prev_post.length) {
  $("<%= j(render(:partial => 'post', :locals => {post: @post, board: @post.board})) %>").insertAfter(prev_post);
} else {
  $('#posts ul#<%= @post.category.downcase %>').prepend($("<%= j(render(:partial => 'post', :locals => {post: @post, board: @post.board})) %>"))
}
addEventEditPost($('#post-<%= @post.id %> .edit-post'));
$('#post-<%= @post.id %> .edit-comment').each(function(index, value) {
  addEventEditComment(value, <%= @post.id %>);
})
addTextcompleteForHashtagsAndUsertags($('#post-<%= @post.id %> .textcomplete'))
