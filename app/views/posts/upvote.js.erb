//for this and downvote could use next_post and append either way works
var prev_post = $('#post-<%= @post.id %>').prev();
$('#post-<%= @post.id %>').remove();
if (prev_post.length) {
  $("<%= j(render(:partial => 'post', :locals => {post: @post})) %>").insertAfter(prev_post);
} else {
  $('#posts ul#<%= @post.category.downcase %>').prepend($("<%= j(render(:partial => 'post', :locals => {post: @post})) %>"))
}

<%= render partial: 'layouts/move_post_up', locals: { up_votes: @up_votes, post: @post }  %>
