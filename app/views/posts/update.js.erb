//maybe refactor post doesn't always move after update, same code as comments/create&destroy.js.erb
$('#post-<%= @post.id %>').remove();
//maybe change @post.board to data-board-id
$('#posts ul#<%= @post.category.downcase %>').append("<%= j(render(:partial => 'post', :locals => {post: @post, board: @post.board})) %>")
addEventEditPost($('#post-<%= @post.id %> .edit-post'));
$('#post-<%= @post.id %> .edit-comment').each(function(index, value) {
  addEventEditComment(value, <%= @post.id %>);
})

<%= render partial: 'layouts/move_post_up', locals: { up_votes: @post.votes.sum(:value), post: @post, moved: true }  %>
