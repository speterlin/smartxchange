$('#post-<%= @post.id %>').remove();
$('#posts ul#<%= @post.category.downcase %>').append("<%= j(render(:partial => 'post', :locals => {post: @post})) %>")
addEventEditPost($('#post-<%= @post.id %> .edit-post'));

<%= render partial: 'layouts/move_post_up', locals: { up_votes: @post.votes.sum(:value), post: @post }  %>
