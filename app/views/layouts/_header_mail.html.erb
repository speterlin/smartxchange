<!DOCTYPE html>
<html>
<head>
  <meta content='text/html; charset=UTF-8' http-equiv='Content-Type' />
  <style type="text/css" media="screen">
    body {
      font-family:"Roboto Slab","Helvetica Neue",Helvetica,Arial,sans-serif;
    }
    ul { padding: 0px;}
    li { list-style-type: none;}
    #mail-header { background-color:#8fb8e2; height: 90px;}
    #mail-header img { padding-left: 5px;}
    .mail-user {
      overflow:auto;
      display: table;
      margin-top: 15px;
      padding-left: 10px;
    }
    /*maybe refactor, the below 3 methods are somewhat of a hack - table-cell within table-cell etc */
    .mail-user-img {
      display:table-cell;
      vertical-align:middle;
      width: 50px;
    }
    .mail-user-img .circle {
      background-color: #000;
      border-radius: 50%;
      overflow: hidden;
      height: 50px;
      width: 50px;
      display: table;
    }
    .mail-user-img .circle p {
      display: table-cell;
      vertical-align: middle;
    }
    /*maybe refactor, display block to get rid of space around img within mail-user-img and margin auto to get image to center horizontally*/
    .mail-user-img .circle p img {
      display: block;
      margin: auto;
    }
    .mail-user-text {
      display:table-cell;
      padding-left: 10px;
      line-height: 25px;
    }
    .mail-user-text p {
      line-height:120%;
      margin-bottom:5px;
      margin-top:0px;
    }
    .mail-btn {
      color:#fff;
      background-color:#fed136;
      border-color:#fed136;
      border: 1px solid transparent;
      font-family:Montserrat,"Helvetica Neue",Helvetica,Arial,sans-serif;
      text-transform:uppercase;
      text-decoration:none;
      font-weight:700;
      border-radius:4px;
      font-size:14px;
      padding: 6px 12px;
      line-height: 1.42857143;
    }
    .mail-btn:hover {
      background-color:#fec503;
    }
    .premium {
      color: #7f7f7f;
      background-color: #000;
      border-color: #ffffff;
    }
    .premium:hover {
      background-color: #000;
      color: #fff;
    }
    .bold-uppercase {
      text-transform:uppercase;
      font-weight: 700;
    }
  </style>
</head>
<body>
  <div id="mail-header">
  </div>
</body>
