<!-- Navigation -->
<nav class="navbar navbar-default navbar-fixed-top">
    <div class="container-header">
      <!-- Brand and toggle get grouped for better mobile display -->
      <div class="navbar-header page-scroll">
          <button type="button" class="navbar-toggle collapsed" data-toggle="collapse" data-target="#smartxchange">
              <span class="sr-only">Toggle navigation</span>
              <span class="icon-bar"></span>
              <span class="icon-bar"></span>
              <span class="icon-bar"></span>
            </button>
        <a class="navbar-brand" href="<%= root_path %>"><%= image_tag('logo.png', alt: 'SmartXchange') %></a>
        <!-- probably refactor need to reposition correctly and put css in a file-->
        <% if signed_in? && current_user.premium? %>
          <span style="color:#fed136;float:left;" id="premium-header">Premium</span>
        <% end %>
      </div>

      <!-- Collect the nav links, forms, and other content for toggling -->
      <div class="collapse navbar-collapse" id="smartxchange">
        <% if signed_in? %><!-- maybe refactor -->
          <div id="search">
            <form action="<%= users_path %>" method="get">
              <input type="text" name="search" class="search-field" placeholder="<%= ["Spanish B1 B2", "Spanish B1 Business Development", "German B2", "French A2", "Italian A2", "English C1", "USA Spanish", "USA Spanish B1 B2", "French Spanish", "French Engineer", "British Marketing"].sample + " ..." %>">
              <input type="submit" value="Search" class="btn btn-primary">
            </form>
          </div>
        <% end %>
        <ul class="nav navbar-nav navbar-right">
          <% if signed_in? %>
            <li class="boards-header dropdown">
              <%= link_to "Boards#{@unread_posts}", "#", class: 'dropdown-toggle', data: {toggle: 'dropdown'}, style: "#{'color:yellow' if boards_have_unread?(current_user)}"  %>
              <ul class="dropdown-menu" style="background-color: #000;">
                <!-- maybe refactor later, especially yellow class  part -->
                <% Board.all.each do |board| %>
                  <% unread_board_posts = user_count_unread_board_notifications(current_user, board) > 0 ? " (#{user_count_unread_board_notifications(current_user, board)})" : "" %>
                  <% if board_has_unread?(board, current_user) %>
                    <li id="board-<%= board.id %>-header"><%= link_to "#{board.title}#{unread_board_posts}", board_path(board) + (board.posts.any? ? "#post-#{board.posts.first.id}" : ""), style: "color:yellow" %> </li>
                  <% else %>
                    <li id="board-<%= board.id %>-header"><%= link_to "#{board.title}#{unread_board_posts}", board_path(board) %> </li>
                  <% end %>
                <% end %>
              </ul>
            </li>
            <li><%= link_to "People", users_path %></li>
            <li id="chat-rooms-header"><%= link_to "Conversations#{@unread_chat_rooms}", chat_rooms_path %></li>
            <li><%= link_to "My profile", user_path(current_user) %></li>
            <li><%= link_to "About", about_path %></li>
            <li class="user-settings dropdown">
              <%= link_to image_tag('settings.png'), "#", class: 'dropdown-toggle', data: {toggle: 'dropdown'}, style: 'margin-right: 10px' %>
              <ul class="dropdown-menu" style="background-color: #000;">
                <li><%= link_to "Settings", user_settings_path(current_user) %></li>
                <li><%= link_to "Log out", session_path, method: :delete %></li>
              </ul>
            </li>
          <% else %>
            <li><%= link_to "Log in", login_path %></li>
            <li><%= link_to "Sign up", signup_path %></li>
          <% end %>
        </ul>
      </div>
      <!-- /.navbar-collapse -->
  </div>
  <!-- /.container-fluid -->
</nav>
