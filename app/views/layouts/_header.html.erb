<!-- Navigation -->
<nav class="navbar navbar-default navbar-fixed-top">
    <div class="container-header">
      <!-- Brand and toggle get grouped for better mobile display -->
      <div class="navbar-header page-scroll">
          <button type="button" class="navbar-toggle collapsed" data-toggle="collapse" data-target="#smartxchange">
              <span class="sr-only">Toggle navigation</span>
              <span class="icon-bar"></span>
              <span class="icon-bar"></span>
              <span class="icon-bar"></span>
            </button>
        <a class="navbar-brand" href="<%= root_path %>">
          <!-- <%= image_tag('logo.png', alt: 'smartXchange') %> -->
        </a>
        <!-- probably refactor need to reposition correctly and put css in a file, maybe make different styling for admin and premium-->
        <% if signed_in? %>
          <% if current_user.admin? %>
            <span id="premium-header">Admin</span>
          <% elsif current_user.premium?  %>
            <span id="premium-header">Premium</span>
          <% end %>
        <% end %>
      </div>

      <!-- Collect the nav links, forms, and other content for toggling -->
      <div class="collapse navbar-collapse" id="smartxchange">
        <% if signed_in? %><!-- maybe refactor -->
          <div id="search">
            <form action="<%= users_path %>" method="get">
              <input type="text" name="search" class="search-field" placeholder="<%= ["'native' (Nationality) 'practicing '(Language) (Language_level) (keyword)", "Spanish intermediate materials", "Spanish Business Development", "German PhD", "French B2 materials", "Italian beginner", "English chat bot", "native American practicing Spanish", "native Spanish practicing English", "native French practicing Spanish", "French Engineer materials", "British Marketing"].sample + " ..." %>">
              <input type="submit" value="Search" class="btn btn-primary">
            </form>
          </div>
        <% end %>
        <ul class="nav navbar-nav navbar-right">
          <% if signed_in? %>
            <li class="boards-header dropdown">
              <% unread_boards = boards_unread(current_user) %>
              <%= link_to "Boards#{@unread_posts}", "#", class: 'dropdown-toggle', data: {toggle: 'dropdown'}, style: "#{'color:yellow' if unread_boards.any?}"  %>
              <ul class="dropdown-menu">
                <!-- maybe refactor, issue with Boards() post notifications being 1 higher than sum of dropdown post notifications (if don't include check for read == false in user#boards_notifications method)  -->
                <% boards_notifications_count = current_user.boards_notifications_count %>
                <% boards_postable.each do |board| %>
                  <li id="board-<%= board.id %>-header"><%= link_to "#{board.title}#{boards_notifications_count[board.id] ? ' (' + boards_notifications_count[board.id].to_s + ')' : ''}", board_path(board), style: "#{'color:yellow' if unread_boards[board.id]}" %> </li>
                <% end %>
              </ul>
            </li>
            <li><%= link_to "People", users_path %></li>
            <li id="chat-rooms-header"><%= link_to "Conversations#{@unread_chat_rooms}", "/conversations" %></li>
            <li><%= link_to "My profile", user_path(current_user) %></li>
            <li><%= link_to "About", about_path %></li>
            <li class="user-settings dropdown">
              <%= link_to image_tag('settings.png'), "#", class: 'dropdown-toggle', data: {toggle: 'dropdown'}, style: 'margin-right: 10px' %>
              <ul class="dropdown-menu">
                <li><%= link_to "Settings", user_settings_path(current_user) %></li>
                <li><%= link_to "Log out", session_path, method: :delete %></li>
              </ul>
            </li>
          <% else %>
            <li><%= link_to "Log in", login_path %></li>
            <li><%= link_to "Sign up", signup_path %></li>
          <% end %>
        </ul>
      </div>
    </div>
</nav>
<script>
  // maybe refactor and move to application.js.erb, right now only used in _header.html.erb
  $('.search-field').textcomplete([
    {
      match: /(\s|^)(\w+)$/,
      search: function (term, callback) {
        $.getJSON('/users/autocomplete', { query: term })
          .done(function (resp) { callback(resp); })
          .fail(function ()     { callback([]);   });
      },
      replace: function (value) {
        return '$1' + value + ' ';
      }
    }
  ]);
</script>
