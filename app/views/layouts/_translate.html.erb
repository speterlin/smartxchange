<div id="translation-section">
  <div id="select-languages">
    From:
    <!-- maybe refactor to inherit User::LANGUAGES -->
    <select id="from-language">
        <option value="en" <%= 'selected' if user_convert_to_language(current_user.nationality) == 'English' %> >English</option>
        <option value="es" <%= 'selected' if user_convert_to_language(current_user.nationality) == 'Spanish' %> >Spanish</option>
        <option value="de" <%= 'selected' if user_convert_to_language(current_user.nationality) == 'German' %> >German</option>
        <option value="fr" <%= 'selected' if user_convert_to_language(current_user.nationality) == 'French' %> >French</option>
        <option value="it" <%= 'selected' if user_convert_to_language(current_user.nationality) == 'Italian' %> >Italian</option>
        <option value="zh-CN" <%= 'selected' if user_convert_to_language(current_user.nationality) == 'Portuguese' %> >Portuguese</option>
        <option value="da" <%= 'selected' if user_convert_to_language(current_user.nationality) == 'Danish' %> >Danish</option>
     </select>
     To:
     <select id="to-language">
       <!-- assuming the user is always converting into the language they want to practice -->
        <option value="es" <%= 'selected' if current_user.language=='Spanish'%> >Spanish</option>
        <option value="en" <%= 'selected' if current_user.language=='English'%> >English</option>
        <option value="de" <%= 'selected' if current_user.language=='German'%> >German</option>
        <option value="fr" <%= 'selected' if current_user.language=='French'%> >French</option>
        <option value="it" <%= 'selected' if current_user.language=='Italian'%> >Italian</option>
        <option value="zh-CN" <%= 'selected' if current_user.language=='Portuguese'%> >Portuguese</option>
        <option value="da" <%= 'selected' if current_user.language == 'Danish' %> >Danish</option>
      </select>
  </div>
  <!-- may want to refactor this styling and place somewhere else -->
  <div id="translate-button" onclick="getTranslation()" onmouseover="this.style.color='#fec503';" onmouseout="this.style.color='#000000';">
    Translate
  </div>
  <div id="translation"></div>
</div>
