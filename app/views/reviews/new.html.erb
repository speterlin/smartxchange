<h1>Peer Review</h1>

<p>
  You have exchanged over <%= @chat_room.messages.size %> messages in your <%= @chat_room.title %> conversation with <%= @other_user.name %>.
  <br>Please add a review of <%= @other_user.name %>:
</p>
<form action="<%= user_reviews_path %>" method="post">
  <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
  <input type="hidden" name="review[reviewable_type]" value="<%= @other_user.class.name %>">
  <input type="hidden" name="review[reviewable_id]" value="<%= @other_user.id %>">
  <input type="hidden" name="review[chat_room_id]" value="<%= @chat_room.id  %>">
  <p>
    What language did <%= @other_user.name %> practice?
    <select name="review[language]">
      <% User::LANGUAGES.each do |language|  %>
        <option value="<%= language %>" <%= 'selected' if @other_user.language==language%> ><%= language %></option>
      <% end %>
   </select>
  </p>
  <p>
    How would you rate <%= @other_user.name %>'s language level in this language?
    <select name="review[language_level]">
      <% User::LANGUAGE_LEVELS.each do |language_level| %>
        <option value="<%= language_level %>" <%= 'selected' if @other_user.language_level==language_level %> ><%= user_convert_to_presented_language_level(language_level) %></option>
      <% end %>
   </select>
  </p>
  <label>Comments (optional - won't be displayed, only for our use):<br>
    <textarea name="review[comment]" style="width: 300px; height: 100px;"></textarea>
  </label><br>
  <input type="submit" value="Submit" class="btn btn-primary settings">
</form>
