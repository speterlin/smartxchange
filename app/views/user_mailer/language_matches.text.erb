Dear <%= @user.name %>,
===============================================
<%= @notify_message %> Notify them within 24 hours.

<% if @matches.any? %>
  <ul>
    <% @matches.each do |match| %>
        <li>
          <%= "#{match.name}, #{match.title}" %>
          <%= link_to "Notify", @match_urls[match.id][0], class: 'mail-btn' %>
        </li>
    <% end %>
  </ul>
<% end %>
<%= link_to "Log in", @url_login, class:'mail-btn' %> <%= @login_message %><br><br>
