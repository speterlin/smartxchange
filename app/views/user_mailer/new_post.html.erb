<!DOCTYPE html>
<html>
  <%= render 'layouts/header_mail' %>
  <body>
    <h4>Dear <%= @user.name %>,</h4>
      <div class="mail-user">
        <div class="mail-user-img">
          <div class="circle">
            <p><%= image_tag(attachments["#{@notifier.name}.jpg"].url, alt: "#{@notifier.name}") %></p>
          </div>
        </div>
        <div class="mail-user-text">
          <p><span class="bold-uppercase"> <%= "#{@notifier.name}" %></span>, <%= "#{@notifier.title}, #{@description} " %><span class="bold-uppercase"><%= "#{@board.title}"%></span><%=" board" %></p>
          <%= link_to "View Board", @board_url, class: 'mail-btn' %>
        </div>
      </div>
  </body>
  <%= render 'layouts/footer_mail_simple' %>
</html>
