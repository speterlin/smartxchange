<!DOCTYPE html>
<html>
  <%= render 'layouts/header_mail' %>
  <body>
    <h4>Dear <%= @user.name %>,</h4>
    You and <%= @other_user.name %> have exchanged more than <%= @chat_room.messages.size %> messages.<br>
      <div class="mail-user">
        <div class="mail-user-img">
          <div class="circle">
            <p><%= image_tag("cid:#{@other_user.name.parameterize}.jpg", alt: "#{@other_user.name}") %></p>
          </div>
        </div>
        <div class="mail-user-text">
          <p>Please review  <span class="bold-uppercase"> <%= "#{@other_user.name}" %></span><%= " in your #{@chat_room.title} conversation together" %></p>
          <%= link_to "Review", @peer_review_url, class: 'mail-btn' %>
        </div>
      </div>
  </body>
  <%= render 'layouts/footer_mail_simple' %>
</html>
