<!DOCTYPE html>
<html>
  <%= render 'layouts/header_mail' %>
  <body>
    <h4>Dear <%= @user.name %>,</h4>
      <div class="mail-user">
        <div class="mail-user-img">
          <div class="circle">
            <p><%= image_tag("cid:#{@sender.name.parameterize}.jpg", alt: "#{@sender.name}") %></p>
          </div>
        </div>
        <div class="mail-user-text">
          <p><span class="bold-uppercase"> <%= "#{@sender.name}" %></span>, <%= "#{@sender.title}, has sent you a message in your " %><span class="bold-uppercase"><%= "#{@chat_room.title}"%></span><%=" conversation" %></p>
          <%= link_to "View Conversation", @chat_room_url, class: 'mail-btn' %>
        </div>
      </div>
  </body>
  <%= render 'layouts/footer_mail_simple' %>
</html>
