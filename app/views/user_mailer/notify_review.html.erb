<!DOCTYPE html>
<html>
  <%= render 'layouts/header_mail' %>
  <body>
    <h4>Dear <%= @user.name %>,</h4>
      <div class="mail-user">
        <div class="mail-user-img">
          <div class="circle">
            <p><%= image_tag(attachments["#{@other_user.name}.jpg"].url, alt: "#{@other_user.name}") %></p>
          </div>
        </div>
        <div class="mail-user-text">
          <p><span class="bold-uppercase"> <%= "#{@other_user.name}" %></span><%= " has left you a review of your" %> <span class="bold-uppercase"><%= "#{@review.language}" %></span> <%= "in your #{@review.chat_room.title} conversation together" %></p>
          <%= link_to "See Review", @peer_review_url, class: 'mail-btn' %>
        </div>
      </div>
  </body>
  <%= render 'layouts/footer_mail_simple' %>
</html>
