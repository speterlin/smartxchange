<!DOCTYPE html>
<html>
  <%= render 'layouts/header_mail' %>
  <body>
    <h4>Dear <%= @user.name %>,</h4>
      <p>
        <%= @notify_message %> Notify them within 24 hours.
      </p>
      <% if @matches.any? %>
        <ul>
          <% @matches.each do |match| %>
            <li>
              <div class="mail-user">
                <div class="mail-user-img">
                  <!-- maybe refactor sort of a hackjob to get it to work -->
                  <div class="circle">
                   <p><%= link_to image_tag(attachments["#{match.name}.jpg"].url, alt: "#{match.name}"), @match_urls[match.id][1] %></p>
                  </div>
                </div>
                <div class="mail-user-text">
                  <p><span class="bold-uppercase"><%= "#{match.name}" %></span>, <%= "#{match.title}" %></p>
                  <%= link_to "Notify", @match_urls[match.id][0], class: 'mail-btn' %>
                </div>
              </div>
            </li>
          <% end %>
        </ul>
      <% end %>
  </body>
  <br><%= link_to "Log in", @url_login, class:'mail-btn' %> <%= @login_message %><br>
  <%= render 'layouts/footer_mail_simple' %>

</html>
