# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# If you find yourself ignoring temporary files generated by your text editor
# or operating system, you probably want to add a global ignore instead:
#   git config --global core.excludesfile '~/.gitignore_global'

# Ignore bundler config.
/.bundle

# Ignore ruby version, already specified in gemfile
/.ruby-version

# Ignore the default SQLite database.
/db/*.sqlite3
/db/*.sqlite3-journal

# Ignore all logfiles and tempfiles.
/log/*
!/log/.keep
/tmp
/public/uploads/tmp

# Ignore .DS_Store files, don't know why these are created
.DS_Store
*/.DS_Store

# Ignore byebug history
.byebug_history

# Ignore deleted files
/deleted

# Ignore application.yml with secret variables
/config/application.yml

# Ignore logo image assets since it's a public repo now
/app/assets/images/logo.png
/app/assets/images/logo-square.png
/app/assets/images/apple-touch-icon-v2-144.png
/app/assets/images/apple-touch-icon.png


# Ignore files relating to downloading of data
dump.csv
export.rb
latest.dump
public/data.csv
users.csv
users.xlsx

# Ignore Google Cloud Natural Language api key, used for NLP requests not in this app
smartXchange-e6508ca55640.json
